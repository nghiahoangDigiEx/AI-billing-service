# Database
DATABASE_URL="postgresql://user:password@localhost:5432/billing_service?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-token-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Application
PORT=3000

# Stripe Configuration
# Get your API keys from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Webhook signing secret - get from https://dashboard.stripe.com/webhooks
# After creating a webhook endpoint, click to reveal the signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# Stripe Price ID for the Free plan - create this in Stripe Dashboard first
# This is used to automatically subscribe new users to the Free plan
STRIPE_FREE_PLAN_PRICE_ID="price_your_free_plan_price_id"

# Billing retry configuration
BILLING_RETRY_INTERVAL=300000  # 5 minutes in milliseconds
BILLING_MAX_RETRIES=5
